{
  "name": "@team-telnyx/openclaw-provider",
  "version": "0.1.0",
  "description": "Official Telnyx AI inference provider plugin for OpenClaw.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/team-telnyx/openclaw-telnyx-provider"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run test/index.test.ts test/models.test.ts",
    "test:live": "vitest run test/telnyx.live.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.7"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "openclaw": "2026.7.2-beta.7",
    "typebox": "1.3.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@team-telnyx/openclaw-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.2-beta.7"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.7"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.7"
    }
  }
}
